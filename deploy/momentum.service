# systemd unit for the Momentum server.
# Install: sudo cp deploy/momentum.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now momentum
[Unit]
Description=Momentum workout dashboard
After=network.target

[Service]
User=momentum
WorkingDirectory=/home/momentum/Momentum
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

# Secrets and settings live in /etc/momentum.env (chmod 600), not here.
EnvironmentFile=/etc/momentum.env
# Only reachable through the local reverse proxy (Caddy).
Environment=HOST=127.0.0.1
Environment=PORT=3000
# server.js spawns the `claude` CLI; the native installer puts it in
# ~/.local/bin, which systemd's default PATH does not include.
Environment=PATH=/home/momentum/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
